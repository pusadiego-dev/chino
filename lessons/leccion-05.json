  "gramatica": [
    {
      "titulo": "El interrogativo 几",
      "explicacion": "几 pregunta por una cantidad, normalmente menor de 10. Suele ir con un clasificador: 几口人, 几个, 几岁.",
      "ejemplos": [
        {
          "hanzi": "你有几个汉语老师？",
          "pinyin": "Nǐ yǒu jǐ ge Hànyǔ lǎoshī?",
          "es": "¿Cuántos profesores de chino tienes?"
        },
        {
          "hanzi": "李老师家有几口人？",
          "pinyin": "Lǐ lǎoshī jiā yǒu jǐ kǒu rén?",
          "es": "¿Cuántos son en la familia del profesor Li?"
        }
      ]
    },
    {
      "titulo": "Los números hasta 100",
      "explicacion": "Del 1 al 10: 一 二 三 四 五 六 七 八 九 十. Las decenas se forman con número + 十 (二十 = 20, 五十 = 50) y luego se añaden las unidades (二十三 = 23, 九十九 = 99). Del 11 al 19 se dice 十 + unidad (十九 = 19). El cero es 零 (líng). Para los ordinales se antepone 第: 第一 (primero), 第二 (segundo).",
      "ejemplos": [
        {
          "hanzi": "二十三",
          "pinyin": "èrshísān",
          "es": "23"
        },
        {
          "hanzi": "五十六",
          "pinyin": "wǔshíliù",
          "es": "56"
        },
        {
          "hanzi": "八十八",
          "pinyin": "bāshíbā",
          "es": "88"
        }
      ]
    },
    {
      "titulo": "了 para indicar un cambio",
      "explicacion": "了 al final de la frase indica un cambio o una situación nueva, como cumplir años.",
      "ejemplos": [
        {
          "hanzi": "李老师今年50岁了。",
          "pinyin": "Lǐ lǎoshī jīnnián wǔshí suì le.",
          "es": "El profesor Li ya tiene 50 años."
        },
        {
          "hanzi": "你女儿几岁了？",
          "pinyin": "Nǐ nǚ'ér jǐ suì le?",
          "es": "¿Cuántos años tiene ya tu hija?"
        }
      ]
    },
    {
      "titulo": "多 + 大 para preguntar la edad",
      "explicacion": "多大 pregunta la edad de un adulto o de alguien mayor que un niño pequeño. Para niños se suele usar 几岁.",
      "ejemplos": [
        {
          "hanzi": "你多大了？",
          "pinyin": "Nǐ duō dà le?",
          "es": "¿Cuántos años tienes?"
        },
        {
          "hanzi": "李老师多大了？",
          "pinyin": "Lǐ lǎoshī duō dà le?",
          "es": "¿Qué edad tiene el profesor Li?"
        }
      ]
    },
    {
      "titulo": "Caracteres y orden de trazos",
      "explicacion": "女 era una mujer arrodillada. 了 era un bebé ya nacido y hoy es una palabra gramatical. 大 es una persona con brazos y piernas abiertos, lo contrario de 小. Orden de trazos: primero lo de fuera y luego lo de dentro (四, 国), y primero el centro y luego los lados (小, 水)."
    }

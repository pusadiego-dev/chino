  "gramatica": [
    {
      "titulo": "Iniciales y finales del pinyin (1)",
      "explicacion": "Iniciales: b p m f · d t n l · g k h · j q x. Finales: i u ü er · a ia ua · o uo · e ie üe · ai uai · ei uei (ui) · ao iao."
    },
    {
      "titulo": "Los cuatro tonos",
      "explicacion": "1.º alto y plano (55), 2.º ascendente (35), 3.º baja y sube (214), 4.º descendente (51). El tono cambia el significado.",
      "ejemplos": [
        {
          "hanzi": "妈",
          "pinyin": "mā",
          "es": "madre"
        },
        {
          "hanzi": "麻",
          "pinyin": "má",
          "es": "cáñamo"
        },
        {
          "hanzi": "马",
          "pinyin": "mǎ",
          "es": "caballo"
        },
        {
          "hanzi": "骂",
          "pinyin": "mà",
          "es": "regañar"
        }
      ]
    },
    {
      "titulo": "La sílaba china",
      "explicacion": "Una sílaba tiene inicial, final y tono; normalmente un carácter es una sílaba. Puede no tener inicial, pero siempre tiene final y tono. Si i o ü van solas se escribe y delante (y ü pierde los puntos: yu); si u va sola se escribe w delante (wu).",
      "ejemplos": [
        {
          "hanzi": "猫",
          "pinyin": "māo",
          "es": "gato (m + ao, 1.er tono)"
        },
        {
          "hanzi": "鱼",
          "pinyin": "yú",
          "es": "pez (ü, 2.º tono)"
        },
        {
          "hanzi": "姐",
          "pinyin": "jiě",
          "es": "hermana mayor (j + ie, 3.er tono)"
        },
        {
          "hanzi": "二",
          "pinyin": "èr",
          "es": "dos (er, 4.º tono)"
        }
      ]
    },
    {
      "titulo": "Cambio de tono: 3.º + 3.º",
      "explicacion": "Cuando van dos sílabas de 3.er tono seguidas, la primera se pronuncia en 2.º tono (3+3 → 2+3). Al escribir se mantiene el tono original.",
      "ejemplos": [
        {
          "hanzi": "你好",
          "pinyin": "nǐ hǎo (se dice ní hǎo)",
          "es": "hola"
        },
        {
          "hanzi": "可以",
          "pinyin": "kěyǐ (se dice kéyǐ)",
          "es": "poder, estar permitido"
        }
      ]
    }
  ]
}

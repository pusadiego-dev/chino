  "gramatica": [
    {
      "titulo": "El verbo modal 会 (1)",
      "explicacion": "会 + verbo indica una habilidad que se ha aprendido (saber hacer algo). La negación es 不会.",
      "ejemplos": [
        { "hanzi": "我会写汉字。", "pinyin": "Wǒ huì xiě Hànzì.", "es": "Sé escribir caracteres chinos." },
        { "hanzi": "我不会做中国菜。", "pinyin": "Wǒ bú huì zuò Zhōngguó cài.", "es": "No sé hacer comida china." },
        { "hanzi": "你妈妈会说汉语吗？", "pinyin": "Nǐ māma huì shuō Hànyǔ ma?", "es": "¿Tu madre sabe hablar chino?" }
      ]
    },
    {
      "titulo": "Frases con adjetivo",
      "explicacion": "Sujeto + adverbio de grado (normalmente 很) + adjetivo describe cómo es algo. No se usa 是. La negación es sujeto + 不 + adjetivo.",
      "ejemplos": [
        { "hanzi": "我很好。", "pinyin": "Wǒ hěn hǎo.", "es": "Estoy muy bien." },
        { "hanzi": "我妈妈的汉语不好。", "pinyin": "Wǒ māma de Hànyǔ bù hǎo.", "es": "El chino de mi madre no es bueno." },
        { "hanzi": "中国菜很好吃。", "pinyin": "Zhōngguó cài hěn hǎochī.", "es": "La comida china está muy rica." }
      ]
    },
    {
      "titulo": "El interrogativo 怎么 (1)",
      "explicacion": "怎么 + verbo pregunta cómo se hace algo.",
      "ejemplos": [
        { "hanzi": "这个汉字怎么读？", "pinyin": "Zhège Hànzì zěnme dú?", "es": "¿Cómo se lee este carácter?" },
        { "hanzi": "你的汉语名字怎么写？", "pinyin": "Nǐ de Hànyǔ míngzi zěnme xiě?", "es": "¿Cómo se escribe tu nombre chino?" }
      ]
    },
    {
      "titulo": "Tonos en palabras de dos sílabas (1)",
      "explicacion": "1.er tono + 1.º/2.º/3.º/4.º: 咖啡 kāfēi, 公园 gōngyuán, 机场 jīchǎng, 车站 chēzhàn. Ojo: dentro de una palabra el 3.er tono se dice más bajo (211), sin la subida final que tiene cuando va solo."
    },
    {
      "titulo": "Trazos y estructura de los caracteres",
      "explicacion": "Trazos nuevos: 撇折 (como en 么 y 东), 斜钩 (gancho inclinado, como en 我 y 钱) y 提 (trazo ascendente, como en 我 y 打). 东 es el este, donde sale el sol; 我 era un arma con dientes afilados y hoy es el pronombre yo; 西 era un nido de pájaro y hoy es el oeste. Hay caracteres de un solo componente (人) y caracteres compuestos de dos o más partes (你)."
    }
  ]
}

  "gramatica": [
    {
      "titulo": "Cómo decir la fecha",
      "explicacion": "En chino se va de lo grande a lo pequeño: primero el mes (月), luego el día (号, o 日 por escrito) y al final el día de la semana (星期). Los días de la semana son 星期 + número del 一 al 六, y el domingo es 星期日 o 星期天. Para preguntar se usa 几: 几月几号？ 星期几？",
      "ejemplos": [
        { "hanzi": "今天9月1号，星期三。", "pinyin": "Jīntiān jiǔ yuè yī hào, xīngqī sān.", "es": "Hoy es miércoles, 1 de septiembre." },
        { "hanzi": "昨天是8月31号，星期二。", "pinyin": "Zuótiān shì bā yuè sānshíyī hào, xīngqī èr.", "es": "Ayer fue martes, 31 de agosto." }
      ]
    },
    {
      "titulo": "Frases con predicado nominal",
      "explicacion": "Para la edad, la fecha o el día de la semana, el predicado puede ser directamente un sustantivo o número, sin 是.",
      "ejemplos": [
        { "hanzi": "今天星期三。", "pinyin": "Jīntiān xīngqī sān.", "es": "Hoy es miércoles." },
        { "hanzi": "今天9月1号。", "pinyin": "Jīntiān jiǔ yuè yī hào.", "es": "Hoy es 1 de septiembre." }
      ]
    },
    {
      "titulo": "去 + lugar + hacer algo",
      "explicacion": "Dos verbos seguidos: el primero (去) dice adónde va alguien y el segundo dice a qué va.",
      "ejemplos": [
        { "hanzi": "我去学校看书。", "pinyin": "Wǒ qù xuéxiào kàn shū.", "es": "Voy a la escuela a leer." },
        { "hanzi": "你去学校做什么？", "pinyin": "Nǐ qù xuéxiào zuò shénme?", "es": "¿A qué vas a la escuela?" }
      ]
    },
    {
      "titulo": "Tonos en palabras de dos sílabas (2)",
      "explicacion": "2.º tono + 1.º/2.º/3.º/4.º: 时间 shíjiān, 银行 yínháng, 词典 cídiǎn, 蓝色 lánsè."
    }
  ],

  "gramatica": [
    {
      "titulo": "La fecha va de lo grande a lo pequeño",
      "explicacion": "Al revés que en español: primero el año (年), luego el mes (月), el día (号) y al final el día de la semana (星期). Para decirla no hace falta 是.",
      "ejemplos": [
        {
          "hanzi": "二零二六年十一月十六号，星期一",
          "pinyin": "Èr líng èr liù nián shíyī yuè shíliù hào, xīngqī yī",
          "es": "lunes, 16 de noviembre de 2026"
        },
        {
          "hanzi": "今天五月八号。",
          "pinyin": "Jīntiān wǔ yuè bā hào.",
          "es": "Hoy es 8 de mayo."
        }
      ]
    },
    {
      "titulo": "Los años se dicen cifra a cifra",
      "explicacion": "Un año no se lee como un número entero: se dice cada cifra y después 年. El 0 es 零 líng.",
      "ejemplos": [
        {
          "hanzi": "一九九零年",
          "pinyin": "Yī jiǔ jiǔ líng nián",
          "es": "1990"
        },
        {
          "hanzi": "二零二六年",
          "pinyin": "Èr líng èr liù nián",
          "es": "2026"
        }
      ]
    },
    {
      "titulo": "Días de la semana y meses: 星期 o número + 月",
      "explicacion": "Los días son 星期 + 一 a 六 (lunes a sábado), y el domingo es 星期天 o 星期日. Los meses son el número + 月: 一月 es enero, 十二月 diciembre. Verás también 周一, 周二… como forma corta de los días.",
      "ejemplos": [
        {
          "hanzi": "星期五",
          "pinyin": "Xīngqī wǔ",
          "es": "viernes"
        },
        {
          "hanzi": "九月",
          "pinyin": "Jiǔ yuè",
          "es": "septiembre"
        }
      ]
    },
    {
      "titulo": "Cuidado con el orden: 一个月 o 一月",
      "explicacion": "Con clasificador es una duración y sin él es un nombre: 一个月 es «un mes» y 一月 es «enero». Igual con la semana: 一个星期 es «una semana» y 星期一 es «lunes».",
      "ejemplos": [
        {
          "hanzi": "一个月",
          "pinyin": "Yí ge yuè",
          "es": "un mes"
        },
        {
          "hanzi": "一月",
          "pinyin": "Yī yuè",
          "es": "enero"
        },
        {
          "hanzi": "一个星期",
          "pinyin": "Yí ge xīngqī",
          "es": "una semana"
        }
      ]
    },
    {
      "titulo": "Pasado, presente y futuro: 上, 这, 下",
      "explicacion": "Para semanas y meses se usa 上 (anterior), 这 (este) y 下 (siguiente) + 个: 上个星期, 下个月. Los años son especiales: 去年, 今年, 明年. Y los días: 前天, 昨天, 今天, 明天, 后天.",
      "ejemplos": [
        {
          "hanzi": "上个月",
          "pinyin": "Shàng ge yuè",
          "es": "el mes pasado"
        },
        {
          "hanzi": "下个星期",
          "pinyin": "Xià ge xīngqī",
          "es": "la semana que viene"
        },
        {
          "hanzi": "去年",
          "pinyin": "Qùnián",
          "es": "el año pasado"
        }
      ]
    },
    {
      "titulo": "Preguntar con 几 y 哪",
      "explicacion": "Se pone 几 donde iría el número, sin cambiar el orden: 几月几号？ 星期几？ Para el año se dice 哪年.",
      "ejemplos": [
        {
          "hanzi": "今天星期几？",
          "pinyin": "Jīntiān xīngqī jǐ?",
          "es": "¿Qué día es hoy?"
        },
        {
          "hanzi": "你的生日是几月几号？",
          "pinyin": "Nǐ de shēngrì shì jǐ yuè jǐ hào?",
          "es": "¿Cuándo es tu cumpleaños?"
        }
      ]
    },
    {
      "titulo": "El cuándo va antes del verbo",
      "explicacion": "Las palabras de tiempo (明天, 下个星期, 周末…) van delante del verbo, al principio de la frase o justo detrás del sujeto. Nunca al final como en español.",
      "ejemplos": [
        {
          "hanzi": "我明天去学校。",
          "pinyin": "Wǒ míngtiān qù xuéxiào.",
          "es": "Mañana voy a la escuela."
        },
        {
          "hanzi": "明天我去学校。",
          "pinyin": "Míngtiān wǒ qù xuéxiào.",
          "es": "Mañana voy a la escuela."
        }
      ]
    }
  ],
  "notas": "Lección comodín: siempre abierta y fuera del orden de las lecciones. Para practicar, cada mañana di en voz alta la fecha completa y el día de la semana."
}
  "gramatica": [
    {
      "titulo": "Iniciales y finales del pinyin (2)",
      "explicacion": "Iniciales: zh ch sh r · z c s. Finales: ou iou (iu) · an ian uan üan · en in uen (un) ün · ang iang uang · eng ing ueng · ong iong."
    },
    {
      "titulo": "El tono neutro",
      "explicacion": "Además de los cuatro tonos hay un tono corto y ligero, el tono neutro (轻声). No se marca con tilde. Es típico en la segunda sílaba de palabras repetidas o con sufijos como 们 y 子.",
      "ejemplos": [
        {
          "hanzi": "妈妈",
          "pinyin": "māma",
          "es": "mamá"
        },
        {
          "hanzi": "爸爸",
          "pinyin": "bàba",
          "es": "papá"
        },
        {
          "hanzi": "我们",
          "pinyin": "wǒmen",
          "es": "nosotros"
        }
      ]
    },
    {
      "titulo": "Dónde se pone la marca del tono",
      "explicacion": "La marca va sobre la vocal más abierta, en este orden: a, o, e, i, u, ü. Excepción: en iu (forma corta de iou) la marca va sobre la u. El tono neutro no se marca.",
      "ejemplos": [
        {
          "hanzi": "学校",
          "pinyin": "xuéxiào",
          "es": "escuela"
        },
        {
          "hanzi": "篮球",
          "pinyin": "lánqiú",
          "es": "baloncesto"
        }
      ]
    },
    {
      "titulo": "Abreviaturas: iou, uei, uen",
      "explicacion": "Cuando iou, uei y uen van detrás de una inicial se escriben iu, ui y un. Por ejemplo: niu, gui, lun.",
      "ejemplos": [
        {
          "hanzi": "水果",
          "pinyin": "shuǐguǒ",
          "es": "fruta"
        },
        {
          "hanzi": "牛奶",
          "pinyin": "niúnǎi",
          "es": "leche"
        }
      ]
    },
    {
      "titulo": "Caracteres: 山, 小, 不",
      "explicacion": "山 (shān) dibuja picos de montaña. 小 (xiǎo) dibujaba granos de arena y hoy significa pequeño, lo contrario de 大. 不 (bù) era una herramienta y hoy es el adverbio de negación."
    },
    {
      "titulo": "El tono de 不",
      "explicacion": "不 es de 4.º tono (bù), pero delante de otra sílaba de 4.º tono se pronuncia en 2.º tono: bú xiè, bú kèqi."
    }
  ]
}

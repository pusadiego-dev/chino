  "gramatica": [
    {
      "titulo": "El pronombre interrogativo 什么",
      "explicacion": "什么 (qué) pregunta por algo. Va en el lugar de lo que se pregunta, solo o delante de un sustantivo. El orden de la frase no cambia.",
      "ejemplos": [
        {
          "hanzi": "你叫什么名字？",
          "pinyin": "Nǐ jiào shénme míngzi?",
          "es": "¿Cómo te llamas?"
        },
        {
          "hanzi": "这是什么？",
          "pinyin": "Zhè shì shénme?",
          "es": "¿Qué es esto?"
        },
        {
          "hanzi": "这是什么书？",
          "pinyin": "Zhè shì shénme shū?",
          "es": "¿Qué libro es este?"
        }
      ]
    },
    {
      "titulo": "Frases con 是",
      "explicacion": "Sujeto + 是 + sustantivo dice qué es o a qué pertenece alguien o algo. Para negar se pone 不 delante de 是: 不是 (bú shì).",
      "ejemplos": [
        {
          "hanzi": "李月是老师。",
          "pinyin": "Lǐ Yuè shì lǎoshī.",
          "es": "Li Yue es profesora."
        },
        {
          "hanzi": "我是美国人。",
          "pinyin": "Wǒ shì Měiguó rén.",
          "es": "Soy estadounidense."
        },
        {
          "hanzi": "我不是老师。",
          "pinyin": "Wǒ bú shì lǎoshī.",
          "es": "No soy profesor."
        }
      ]
    },
    {
      "titulo": "Preguntas con 吗",
      "explicacion": "Añadiendo 吗 al final de una frase afirmativa se convierte en una pregunta de sí o no.",
      "ejemplos": [
        {
          "hanzi": "你是美国人吗？",
          "pinyin": "Nǐ shì Měiguó rén ma?",
          "es": "¿Eres estadounidense?"
        },
        {
          "hanzi": "你是老师吗？",
          "pinyin": "Nǐ shì lǎoshī ma?",
          "es": "¿Eres profesor?"
        }
      ]
    },
    {
      "titulo": "Pronunciación: j, q, x y z, c, s",
      "explicacion": "j, q, x se pronuncian con el dorso de la lengua contra el paladar duro: j sin soplo de aire, q con un soplo fuerte, y en x la lengua se acerca sin tocar y deja pasar el aire."
    },
    {
      "titulo": "Trazos y caracteres: 月, 心, 中, 人",
      "explicacion": "Trazos nuevos: 横折钩 (horizontal que gira con gancho, como en 门 y 月) y 卧钩 (gancho tumbado, como en 心 y 您). 月 dibuja la luna, 心 el corazón, 中 era una bandera ondeando y hoy significa medio, y 人 es una persona de pie."
    }
  ]
}
